!!!
%html{:lang => "en"}
  %head
    %meta{:charset => "UTF-8"}/
    %meta{:content => "width=device-width, initial-scale=1.0", :name => "viewport"}/
    %title <%= humanized_app_name %>
    <%- if generate_assets? -%>
    = favicon_tag
    = stylesheet_tag "app"
    <%- end -%>
  %body
    = yield
    <%- if generate_assets? -%>
    = javascript_tag "app"
    <%- end -%>
