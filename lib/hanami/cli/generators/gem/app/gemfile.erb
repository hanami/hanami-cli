# frozen_string_literal: true

source "<%= gem_source %>"

<%- if gem_coop? and !hanami_head? -%>
source "https://gem.coop/@hanami" do
  <%= hanami_gem("hanami") %>
  <%- if generate_assets? -%>
  <%= hanami_gem("assets") %>
  <%- end -%>
  <%= hanami_gem("action") %>
  <%- if generate_db? -%>
  <%= hanami_gem("db") %>
  <%- end -%>
  <%= hanami_gem("router") %>
  <%- if generate_view? -%>
  <%= hanami_gem("view") %>
  <%- end -%>
end
<%- else -%>
<%= hanami_gem("hanami") %>
<%- if hanami_head? -%>
<%= hanami_gem("cli") %>
<%= hanami_gem("utils") %>
<%- end -%>
<%- if generate_assets? -%>
<%= hanami_gem("assets") %>
<%- end -%>
<%= hanami_gem("action") %>
<%- if generate_db? -%>
<%= hanami_gem("db") %>
<%- end -%>
<%- if generate_mailer? -%>
<%= hanami_gem("mailer") %>
<%- end -%>
<%= hanami_gem("router") %>
<%- if generate_view? -%>
<%= hanami_gem("view") %>
<%- end -%>
<%- end -%>

<%- if gem_coop? -%>
source "https://gem.coop/@dry" do
  gem "dry-types", "~> 1.7"
  gem "dry-operation", ">= 1.0.1"
  gem "dry-validation", "~> 1.11"
end

<%- else -%>
gem "dry-types", "~> 1.7"
gem "dry-operation", ">= 1.0.1"
gem "dry-validation", "~> 1.11"
<%- end -%>
gem "i18n", "~> 1.14"
gem "puma", ">= 7.1"
gem "rake"
<%- if generate_sqlite? -%>
gem "sqlite3"
<%- elsif generate_postgres? -%>
gem "pg"
<%- elsif generate_mysql? -%>
gem "mysql2"
<%- end -%>
<%- if generate_view? && template_engine == "haml" -%>
gem "haml"
<%- end -%>
<%- if generate_view? && template_engine == "slim" -%>
gem "slim"
<%- end -%>

group :development do
  <%= hanami_gem("webconsole") %><%- if gem_coop? -%>, source: "https://gem.coop/@hanami"<% end %>
end

group :development, :test do
  gem "dotenv"
  <%- if generate_db? -%>
  # Syntax highlighting SQL logs
  gem "rouge"
  <%- end -%>
end

group :cli, :development do
  <%= hanami_gem("reloader") %><%- if gem_coop? -%>, source: "https://gem.coop/@hanami"<% end %>
end

group :cli, :development, :test do
<%- if generate_rspec? -%>
  <%= hanami_gem("rspec") %><%- if gem_coop? -%>, source: "https://gem.coop/@hanami"<% end %>
<%- elsif generate_minitest? -%>
  <%= hanami_gem("minitest") %><%- if gem_coop? -%>, source: "https://gem.coop/@hanami"<% end %>
<%- end -%>
end
