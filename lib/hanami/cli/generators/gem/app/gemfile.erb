# frozen_string_literal: true

source "<%= gem_source %>"

<%= hanami_gem("hanami") %>
<%- if hanami_head? -%>
<%= hanami_gem("cli") %>
<%= hanami_gem("utils") %>
<%- end -%>
<%- if generate_assets? -%>
<%= hanami_gem("assets") %>
<%- end -%>
<%= hanami_gem("action") %>
<%- if generate_db? -%>
<%= hanami_gem("db") %>
<%- end -%>
<%= hanami_gem("router") %>
<%- if generate_view? -%>
<%= hanami_gem("view") %>
<%- end -%>

gem "dry-types", "~> 1.7"
gem "dry-operation", ">= 1.0.1"
gem "dry-validation", "~> 1.11"
gem "i18n", "~> 1.14"
gem "puma", ">= 7.1"
gem "rake"
<%- if generate_sqlite? -%>
gem "sqlite3"
<%- elsif generate_postgres? -%>
gem "pg"
<%- elsif generate_mysql? -%>
gem "mysql2"
<%- end -%>
<%- if generate_view? && template_engine == "haml" -%>
gem "haml"
<%- end -%>
<%- if generate_view? && template_engine == "slim" -%>
gem "slim"
<%- end -%>

group :development do
  <%= hanami_gem("webconsole") %>
end

group :development, :test do
  gem "dotenv"
  <%- if generate_db? -%>
  # Syntax highlighting SQL logs
  gem "rouge"
  <%- end -%>
end

group :cli, :development do
  <%= hanami_gem("reloader") %>
end

group :cli, :development, :test do
<%- if generate_rspec? -%>
  <%= hanami_gem("rspec") %>
<%- elsif generate_minitest? -%>
  <%= hanami_gem("minitest") %>
<%- end -%>
end
